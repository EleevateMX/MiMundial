# Mi Mundial — variables de entorno
# Copia este archivo a .env.local y rellena con tus llaves de Supabase.
# (Sin estas variables, la app corre en "modo demo" con datos locales.)

# Project URL  → Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# anon public key → Supabase > Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# (Opcional) hCaptcha — protección anti-bots nativa de Supabase.
# Si la defines, el registro exige resolver el captcha.
# Site key → hCaptcha dashboard. También pega el "secret" en
# Supabase > Authentication > Attack Protection > Captcha.
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# (Opcional) URL pública del sitio, para redirecciones en producción.
# En local puedes omitirla; se usa window.location.origin.
# NEXT_PUBLIC_SITE_URL=https://mimundial.tu-dominio.com
